{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenti.dev/schemas/assignment.schema.json",
  "title": "Agenti explicit role assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assignment_id",
    "issued_at",
    "role",
    "purpose",
    "work_item",
    "state",
    "candidate",
    "context_entrypoints",
    "capability_profile",
    "independence",
    "completion"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assignment_id": {
      "type": "string",
      "minLength": 12
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "role": {
      "enum": [
        "A",
        "D",
        "R",
        "P"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_repository",
        "issue_number"
      ],
      "properties": {
        "control_repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "execution_repository": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "repository"
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "fingerprint",
        "contract_digest"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "contract_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "context_entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "work_item",
              "project_profile",
              "agent_entrypoint",
              "canonical_document",
              "candidate"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capability_profile": {
      "enum": [
        "A_READ_ANALYZE",
        "D_WORKSPACE_WRITE",
        "R_READ_REVIEW",
        "P_PUBLISH"
      ]
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "must_differ_from_execution_instances",
        "enforcement_mechanism"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "must_differ_from_execution_instances": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "enforcement_mechanism": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_schema_version",
        "result_marker",
        "callback_event"
      ],
      "properties": {
        "result_schema_version": {
          "const": 1
        },
        "result_marker": {
          "const": "agenti-role-result:v1"
        },
        "callback_event": {
          "const": "agenti.role-result"
        }
      }
    },
    "semantic_work_digest": {
      "$ref": "#/$defs/digest"
    },
    "execution_route": {
      "$ref": "#/$defs/executionRoute"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "members"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "single",
            "composite"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "head_sha"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[^/]+/[^/]+$"
              },
              "pr_number": {
                "type": "integer",
                "minimum": 1
              },
              "head_sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "base_ref_or_sha": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "executionRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_digest",
        "runner_candidate_id",
        "adapter_id",
        "adapter_version",
        "provider_ref",
        "billing_mode",
        "paid_authority_digest",
        "capacity_observation_digest",
        "billing_safety_digest",
        "routing_attempt_generation"
      ],
      "properties": {
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "runner_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "provider_ref": {
          "type": "string",
          "minLength": 1
        },
        "billing_mode": {
          "enum": [
            "NONE",
            "INCLUDED_ALLOWANCE",
            "PREPAID_CREDIT",
            "METERED"
          ]
        },
        "paid_authority_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "capacity_observation_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "billing_safety_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "routing_attempt_generation": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
