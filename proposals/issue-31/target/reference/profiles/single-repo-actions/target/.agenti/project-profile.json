{
  "schema_version": 1,
  "runtime_version": "1",
  "repository_topology": "single-repo",
  "control_repository": "__OWNER__/__REPOSITORY__",
  "human": {
    "principals": [
      {
        "actor_id": 1,
        "login": "__HUMAN_LOGIN__"
      }
    ]
  },
  "semantic_authority_map": [
    {
      "fact_domain": "product-contract",
      "source_ref": "managed-issue-body",
      "currentness": "current"
    }
  ],
  "required_checks": [],
  "role_runners": {
    "A": {
      "adapter_id": "codex-action",
      "adapter_version": "1",
      "capability_profile": "A_READ_ANALYZE"
    },
    "D": {
      "adapter_id": "codex-action",
      "adapter_version": "1",
      "capability_profile": "D_WORKSPACE_WRITE"
    },
    "R": {
      "adapter_id": "codex-action",
      "adapter_version": "1",
      "capability_profile": "R_READ_REVIEW",
      "independence_mechanism": "codex-fresh-actions-run"
    },
    "P": {
      "adapter_id": "deterministic-actions-publisher",
      "adapter_version": "1",
      "capability_profile": "P_PUBLISH"
    }
  },
  "independent_r_enforcement": {
    "mechanisms": {
      "codex-fresh-actions-run": {
        "attestation_source": "deterministic-wrapper",
        "fresh_execution_required": true,
        "trusted_platform_fields": [
          "run_id",
          "run_attempt"
        ]
      }
    }
  },
  "identities": {
    "O": {
      "identity_id": "github-actions-o",
      "capability_profile": "O_CONTROL_PLANE",
      "dispatch_mechanism": "workflow_dispatch",
      "permissions": {
        "metadata": "read",
        "contents": "read",
        "issues": "write",
        "pull_requests": "read",
        "checks": "read",
        "actions": "write",
        "deployments": "read"
      }
    },
    "P": {
      "identity_id": "github-actions-p",
      "capability_profile": "P_PUBLISH",
      "dispatch_mechanism": "none",
      "permissions": {
        "metadata": "read",
        "contents": "write",
        "issues": "write",
        "pull_requests": "write",
        "checks": "read",
        "actions": "write",
        "deployments": "write"
      }
    }
  },
  "release_authorization": {
    "required": true,
    "target": "default-branch"
  },
  "publication": {
    "boundary_operations": [
      "MERGE"
    ]
  },
  "state_projection": {
    "marker": "agenti-state:v1",
    "single_writer": "O"
  },
  "execution_routing": {
    "runner_catalog": {
      "claude-subscription": {
        "adapter_id": "claude-code-action",
        "adapter_version": "1",
        "provider_ref": "anthropic",
        "capability_profiles": [
          "A_READ_ANALYZE",
          "D_WORKSPACE_WRITE",
          "R_READ_REVIEW"
        ],
        "execution_kind": "AI",
        "authentication_profile": "claude-pro-max-oauth",
        "independence_mechanism": "codex-fresh-actions-run",
        "billing": {
          "mode": "INCLUDED_ALLOWANCE",
          "incremental_paid_usage": false
        },
        "billing_safety": {
          "mode": "OBSERVATION_REQUIRED",
          "required_status": "VERIFIED_NO_PAID_SPILLOVER"
        },
        "capacity": {
          "observation_mode": "EXECUTION_OUTCOME"
        }
      },
      "codex-api-optional": {
        "adapter_id": "codex-action",
        "adapter_version": "1",
        "provider_ref": "openai",
        "capability_profiles": [
          "A_READ_ANALYZE",
          "D_WORKSPACE_WRITE",
          "R_READ_REVIEW"
        ],
        "execution_kind": "AI",
        "authentication_profile": "openai-api-key",
        "independence_mechanism": "codex-fresh-actions-run",
        "billing": {
          "mode": "METERED",
          "incremental_paid_usage": true
        },
        "budget_enforcement": {
          "hard_limit": false,
          "mechanism": "not-configured"
        },
        "capacity": {
          "observation_mode": "ADAPTER_PREFLIGHT"
        }
      },
      "deterministic-p": {
        "adapter_id": "deterministic-actions-publisher",
        "adapter_version": "1",
        "provider_ref": "none",
        "capability_profiles": [
          "P_PUBLISH"
        ],
        "execution_kind": "DETERMINISTIC",
        "billing": {
          "mode": "NONE",
          "incremental_paid_usage": false
        },
        "capacity": {
          "observation_mode": "NONE"
        }
      }
    },
    "policies": [
      {
        "policy_id": "cost-min-adr",
        "match": {
          "roles": [
            "A",
            "D",
            "R"
          ],
          "purposes": [
            "*"
          ]
        },
        "candidates": [
          "claude-subscription"
        ],
        "selection": "ORDERED",
        "paid_execution": {
          "mode": "FORBIDDEN"
        },
        "wait_policy": {
          "on_included_exhausted": "WAIT",
          "try_next_included_before_wait": true,
          "max_wait_seconds": 21600,
          "on_max_wait": "HUMAN",
          "minimum_reconcile_seconds": 900
        }
      },
      {
        "policy_id": "deterministic-p",
        "match": {
          "roles": [
            "P"
          ],
          "purposes": [
            "*"
          ]
        },
        "candidates": [
          "deterministic-p"
        ],
        "selection": "ORDERED",
        "paid_execution": {
          "mode": "FORBIDDEN"
        },
        "wait_policy": {
          "on_included_exhausted": "WAIT",
          "try_next_included_before_wait": true,
          "on_max_wait": "HUMAN",
          "minimum_reconcile_seconds": 900
        }
      }
    ]
  },
  "work_item_claims": {
    "mutation_domain": "github-actions-concurrency",
    "recovery": {
      "mode": "PLATFORM_RUN"
    },
    "material_write_fencing": "REQUIRED"
  },
  "claim_mechanism_capabilities": {
    "linearizable_per_work_item_mutation_domain": true,
    "all_projection_writers_share_domain": true,
    "authoritative_claim_location": "O_PROJECTION",
    "material_write_fencing": "SHARED_DOMAIN",
    "supports_platform_run_recovery": true,
    "supports_heartbeat_lease": false
  }
}
