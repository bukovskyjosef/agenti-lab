{
  "schema_version": 1,
  "runtime_version": "0.1.0-child1",
  "repository_topology": "single-repo",
  "control_repository": "example/product",
  "human": {
    "principals": [
      {
        "actor_id": 1001,
        "login": "product-owner"
      }
    ]
  },
  "semantic_authority_map": [
    {
      "fact_domain": "product-contract",
      "source_ref": "issue-body",
      "currentness": "current"
    }
  ],
  "required_checks": [
    "unit"
  ],
  "role_runners": {
    "A": {
      "adapter_id": "fake",
      "adapter_version": "1",
      "capability_profile": "A_READ_ANALYZE"
    },
    "D": {
      "adapter_id": "fake",
      "adapter_version": "1",
      "capability_profile": "D_WORKSPACE_WRITE"
    },
    "R": {
      "adapter_id": "fake",
      "adapter_version": "1",
      "capability_profile": "R_READ_REVIEW",
      "independence_mechanism": "fresh-wrapper"
    },
    "P": {
      "adapter_id": "deterministic-publisher",
      "adapter_version": "1",
      "capability_profile": "P_PUBLISH"
    }
  },
  "independent_r_enforcement": {
    "mechanisms": {
      "fresh-wrapper": {
        "attestation_source": "deterministic-wrapper",
        "fresh_execution_required": true,
        "trusted_platform_fields": [
          "run_id",
          "run_attempt"
        ]
      }
    }
  },
  "identities": {
    "O": {
      "identity_id": "o-control",
      "capability_profile": "O_CONTROL_PLANE",
      "dispatch_mechanism": "workflow_dispatch",
      "permissions": {
        "metadata": "read",
        "contents": "read",
        "issues": "write",
        "pull_requests": "read",
        "checks": "read",
        "actions": "write",
        "deployments": "read"
      }
    },
    "P": {
      "identity_id": "p-publisher",
      "capability_profile": "P_PUBLISH",
      "dispatch_mechanism": "none",
      "permissions": {
        "metadata": "read",
        "contents": "write",
        "issues": "read",
        "pull_requests": "write",
        "checks": "read",
        "actions": "read",
        "deployments": "write"
      }
    }
  },
  "release_authorization": {
    "required": true,
    "target": "production"
  },
  "publication": {
    "boundary_operations": [
      "MERGE",
      "DEPLOY"
    ]
  },
  "state_projection": {
    "marker": "agenti-state:v1",
    "single_writer": "O"
  },
  "work_item_claims": {
    "mutation_domain": "github-actions-concurrency",
    "recovery": {
      "mode": "PLATFORM_RUN"
    },
    "material_write_fencing": "REQUIRED"
  },
  "claim_mechanism_capabilities": {
    "linearizable_per_work_item_mutation_domain": true,
    "all_projection_writers_share_domain": true,
    "authoritative_claim_location": "O_PROJECTION",
    "material_write_fencing": "SHARED_DOMAIN",
    "supports_platform_run_recovery": true,
    "supports_heartbeat_lease": false
  }
}
