{
  "schema_version": 1,
  "runtime_version": "0.1.0-child1",
  "repository_topology": "single-repo",
  "control_repository": "example/product",
  "human": {
    "principals": [
      {
        "actor_id": 1001,
        "login": "product-owner"
      }
    ]
  },
  "semantic_authority_map": [
    {
      "fact_domain": "product-contract",
      "source_ref": "issue-body",
      "currentness": "current"
    }
  ],
  "required_checks": [
    "unit"
  ],
  "role_runners": {
    "A": {
      "adapter_id": "fake",
      "adapter_version": "1",
      "capability_profile": "A_READ_ANALYZE"
    },
    "D": {
      "adapter_id": "fake",
      "adapter_version": "1",
      "capability_profile": "D_WORKSPACE_WRITE"
    },
    "R": {
      "adapter_id": "fake",
      "adapter_version": "1",
      "capability_profile": "R_READ_REVIEW",
      "independence_mechanism": "fresh-wrapper"
    },
    "P": {
      "adapter_id": "deterministic-publisher",
      "adapter_version": "1",
      "capability_profile": "P_PUBLISH"
    }
  },
  "independent_r_enforcement": {
    "mechanisms": {
      "fresh-wrapper": {
        "attestation_source": "deterministic-wrapper",
        "fresh_execution_required": true,
        "trusted_platform_fields": [
          "run_id",
          "run_attempt"
        ]
      }
    }
  },
  "identities": {
    "O": {
      "identity_id": "o-control",
      "capability_profile": "O_CONTROL_PLANE",
      "dispatch_mechanism": "workflow_dispatch",
      "permissions": {
        "metadata": "read",
        "contents": "read",
        "issues": "write",
        "pull_requests": "read",
        "checks": "read",
        "actions": "write",
        "deployments": "read"
      }
    },
    "P": {
      "identity_id": "p-publisher",
      "capability_profile": "P_PUBLISH",
      "dispatch_mechanism": "none",
      "permissions": {
        "metadata": "read",
        "contents": "write",
        "issues": "read",
        "pull_requests": "write",
        "checks": "read",
        "actions": "read",
        "deployments": "write"
      }
    }
  },
  "release_authorization": {
    "required": true,
    "target": "production"
  },
  "publication": {
    "boundary_operations": [
      "MERGE",
      "DEPLOY"
    ]
  },
  "state_projection": {
    "marker": "agenti-state:v1",
    "single_writer": "O"
  },
  "execution_routing": {
    "runner_catalog": {
      "included-primary": {
        "adapter_id": "fake-subscription-primary",
        "adapter_version": "1",
        "provider_ref": "provider-a",
        "capability_profiles": [
          "A_READ_ANALYZE",
          "D_WORKSPACE_WRITE",
          "R_READ_REVIEW"
        ],
        "execution_kind": "AI",
        "authentication_profile": "subscription-oauth",
        "independence_mechanism": "fresh-wrapper",
        "billing": {
          "mode": "INCLUDED_ALLOWANCE",
          "incremental_paid_usage": false
        },
        "billing_safety": {
          "mode": "OBSERVATION_REQUIRED",
          "required_status": "VERIFIED_NO_PAID_SPILLOVER"
        },
        "capacity": {
          "observation_mode": "ADAPTER_PREFLIGHT"
        }
      },
      "included-secondary": {
        "adapter_id": "fake-subscription-secondary",
        "adapter_version": "1",
        "provider_ref": "provider-b",
        "capability_profiles": [
          "A_READ_ANALYZE",
          "D_WORKSPACE_WRITE",
          "R_READ_REVIEW"
        ],
        "execution_kind": "AI",
        "authentication_profile": "subscription-oauth-b",
        "independence_mechanism": "fresh-wrapper",
        "billing": {
          "mode": "INCLUDED_ALLOWANCE",
          "incremental_paid_usage": false
        },
        "billing_safety": {
          "mode": "TECHNICALLY_ISOLATED"
        },
        "capacity": {
          "observation_mode": "ADAPTER_PREFLIGHT"
        }
      },
      "metered-api": {
        "adapter_id": "fake-metered",
        "adapter_version": "1",
        "provider_ref": "provider-paid",
        "capability_profiles": [
          "A_READ_ANALYZE",
          "D_WORKSPACE_WRITE",
          "R_READ_REVIEW"
        ],
        "execution_kind": "AI",
        "authentication_profile": "api-key",
        "independence_mechanism": "fresh-wrapper",
        "billing": {
          "mode": "METERED",
          "incremental_paid_usage": true
        },
        "budget_enforcement": {
          "hard_limit": true,
          "mechanism": "per-run-hard-cap"
        },
        "capacity": {
          "observation_mode": "ADAPTER_PREFLIGHT"
        }
      },
      "deterministic-p": {
        "adapter_id": "deterministic-publisher",
        "adapter_version": "1",
        "provider_ref": "none",
        "capability_profiles": [
          "P_PUBLISH"
        ],
        "execution_kind": "DETERMINISTIC",
        "billing": {
          "mode": "NONE",
          "incremental_paid_usage": false
        },
        "capacity": {
          "observation_mode": "NONE"
        }
      }
    },
    "policies": [
      {
        "policy_id": "adr-included-first",
        "match": {
          "roles": [
            "A",
            "D",
            "R"
          ],
          "purposes": [
            "*"
          ]
        },
        "candidates": [
          "included-primary",
          "included-secondary"
        ],
        "selection": "ORDERED",
        "paid_execution": {
          "mode": "FORBIDDEN"
        },
        "wait_policy": {
          "on_included_exhausted": "WAIT",
          "try_next_included_before_wait": true,
          "max_wait_seconds": 21600,
          "on_max_wait": "HUMAN",
          "minimum_reconcile_seconds": 900
        }
      },
      {
        "policy_id": "publisher",
        "match": {
          "roles": [
            "P"
          ],
          "purposes": [
            "*"
          ]
        },
        "candidates": [
          "deterministic-p"
        ],
        "selection": "ORDERED",
        "paid_execution": {
          "mode": "FORBIDDEN"
        },
        "wait_policy": {
          "on_included_exhausted": "WAIT",
          "try_next_included_before_wait": true,
          "on_max_wait": "HUMAN",
          "minimum_reconcile_seconds": 900
        }
      }
    ]
  }
}
