{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "status", "result_type", "payload"],
  "properties": {
    "role": { "const": "A" },
    "status": { "enum": ["COMPLETED", "BLOCKED", "FAILED"] },
    "result_type": { "const": "ANALYST" },
    "evidence_refs": { "type": "array", "maxItems": 20 },
    "human_request": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["CLARIFICATION", "DECISION", "HUMAN_ACTION"] },
        "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "resolution_route": { "enum": ["ANALYST_REEVALUATE", "RESUME_CURRENT_AFTER_RECHECK"] }
      },
      "required": ["type", "question", "resolution_route"]
    },
    "retry_or_failure": { "type": ["object", "null"] },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_contract_digest", "disposition", "contract_operations", "blockers"],
      "properties": {
        "base_contract_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "disposition": { "enum": ["READY", "HUMAN_INPUT_REQUIRED", "ANALYSIS_CONTINUES", "BLOCKED"] },
        "contract_operations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "section", "value", "precondition_contract_digest"],
            "properties": {
              "op": { "const": "SET_SECTION" },
              "section": {
                "enum": [
                  "GOAL","CONTEXT","SCOPE","OUT_OF_SCOPE","REQUIREMENTS",
                  "ACCEPTANCE_CRITERIA","CONSTRAINTS","DEPENDENCIES",
                  "CANONICAL_REFERENCES","REQUIRED_CONTROL_GATES","VALIDATION",
                  "DOCUMENTATION_IMPACT","CONCURRENCY_CLASS","SHARED_SURFACES",
                  "DECISION_GATES","RELEASE_POLICY"
                ]
              },
              "value": { "type": ["string","array","object","number","boolean","null"] },
              "precondition_contract_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        },
        "decomposition": { "type": ["object", "null"] },
        "blockers": { "type": "array", "maxItems": 20 }
      }
    }
  }
}
